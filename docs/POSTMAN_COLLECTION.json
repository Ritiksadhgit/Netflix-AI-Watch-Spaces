            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/titles/{{titleId}}/ai/ask",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "titles", "{{titleId}}", "ai", "ask"]
            }
          }
        }
      ]
    },
