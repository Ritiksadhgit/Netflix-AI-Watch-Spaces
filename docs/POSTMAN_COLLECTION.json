    {
      "name": "6. Admin Timeline Studio (ROLE_ADMIN)",
      "item": [
        {
          "name": "Admin: Get Title Timeline",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/titles/{{titleId}}/timeline",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "titles", "{{titleId}}", "timeline"]
            }
          }
        },
        {
          "name": "Admin: Create Marker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tsSeconds\": 120,\n  \"eventType\": \"SCENE\",\n  \"title\": \"Bridge Confrontation\",\n  \"payloadJson\": \"{\\\"description\\\": \\\"The standoff begins.\\\"}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/titles/{{titleId}}/timeline/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "titles", "{{titleId}}", "timeline", "events"]
            }
          }
        },
        {
          "name": "Admin: Update Marker",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tsSeconds\": 125,\n  \"eventType\": \"SCENE\",\n  \"title\": \"Bridge Confrontation Extended\",\n  \"payloadJson\": \"{\\\"description\\\": \\\"The robotic forces advance.\\\"}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/titles/{{titleId}}/timeline/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "titles", "{{titleId}}", "timeline", "events", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Admin: Delete Marker",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/titles/{{titleId}}/timeline/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "titles", "{{titleId}}", "timeline", "events", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Admin: Bulk Import Timeline",
          "request": {
            "method": "POST",
