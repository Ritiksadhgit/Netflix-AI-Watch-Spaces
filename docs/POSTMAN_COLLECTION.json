          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/titles/{{titleId}}/trivia",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "titles", "{{titleId}}", "trivia"]
            }
          }
        },
        {
          "name": "Ask Grounded AI Co-Pilot",
          "request": {
